{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认能力：允许主窗口加载 127.0.0.1 回环地址的 dsh Web UI（ADR-0004 探针定论：/api 非鉴权、无 CSP、同源回环直达）。remote 上下文（dsh 页面）调用应用自定义命令需显式 allow-* 权限（build.rs AppManifest 自动生成，2026-08-25 外链修复）。",
  "windows": [
    "main",
    "about",
    "profiles"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-choose-profile",
    "allow-terminal-action",
    "allow-get-update-status",
    "allow-check-updates",
    "allow-get-client-update",
    "allow-client-update-check",
    "allow-client-update-apply",
    "allow-open-external",
    "allow-open-workbench-in-browser",
    "allow-get-workbench-url",
    "allow-boot-in-wsl",
    "allow-choose-mode",
    "allow-list-profiles",
    "allow-get-profile-detail",
    "allow-create-profile",
    "allow-copy-profile",
    "allow-rename-profile",
    "allow-delete-profile",
    "allow-set-default-profile",
    "allow-get-default-profile",
    "allow-switch-profile",
    "allow-get-active-profile",
    "allow-list-profile-plugins",
    "allow-install-plugin",
    "allow-remove-plugin",
    "allow-update-plugin",
    "allow-get-plugin-rows",
    "allow-set-plugin-disabled",
    "allow-check-plugin-updates",
    "allow-list-plugin-versions",
    "allow-get-plugin-runtime",
    "allow-list-all-plugins",
    "allow-copy-plugin-config",
    "allow-list-sessions",
    "allow-repair-session",
    "allow-repair-all-sessions",
    "allow-get-shell-settings",
    "allow-set-shell-settings",
    "allow-get-system-diagnostics",
    "allow-get-app-logs",
    "allow-get-credentials-raw",
    "allow-save-credentials-raw",
    "allow-get-credentials-summary",
    "allow-set-credential-key",
    "allow-get-dsh-settings-raw",
    "allow-save-dsh-settings-raw",
    "allow-list-mcp-servers",
    "allow-save-mcp-server",
    "allow-delete-mcp-server",
    "allow-delete-session",
    "allow-fetch-market-registry"
  ]
}
