{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Dock",
  "version": "0.6.0",
  "identifier": "io.github.realguan.dsh-dock",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm ci --no-audit --no-fund && npm run build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/realguan/dsh-dock/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/realguan/dsh-dock/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NDFERDZGN0M5RTQ5NUQKUldSZFNaNThiOTFCRlUxMEhMb3R6cW05bVZobkhTNTEyOUJKU05qSlFFYlN0M3JtYnNKYno2VGgK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/product.manifest.json",
      "resources/dsh-snapshot/**/*"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
