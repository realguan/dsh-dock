{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-desktop-shell",
  "version": "0.1.0",
  "identifier": "dev.deepseek.dsh-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/product.manifest.json",
      "resources/dsh-snapshot/**/*"
    ]
  }
}
